DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=sua_senha
DB_NAME=cloud_atividade
PORT=3000
TMDB_API_KEY=sua_chave_tmdb
# Obrigatório, mínimo 16 caracteres. Gere com: openssl rand -hex 32
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio


SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=SEU_USER
SMTP_PASS=SUA_SENHA
PUBLIC_URL=http://localhost:8218

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=troque_esta_senha

GRAFANA_ADMIN_PASSWORD=troque_esta_senha

# Atividade 7: Plano Premium com Stripe (modo de teste)
# Chaves obtidas no dashboard do Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_sua_chave_secreta
STRIPE_WEBHOOK_SECRET=whsec_seu_webhook_secret
# Opcional: ID do preço criado no Stripe (se omitido, o CineCloud busca/cria automaticamente)
STRIPE_PRICE_ID=price_seu_preco_id

# Segurança de borda (ver docs/seguranca.md)
# true quando o site é servido por HTTPS (cookie de sessão só trafega criptografado)
COOKIE_SECURE=false
# Número de proxies reversos na frente do app (ex.: 1 atrás do Traefik/Nginx), para o IP real do cliente
TRUST_PROXY=
# Origens extras autorizadas a chamar a API com cookies (vazio = só a própria origem)
CORS_ORIGINS=
